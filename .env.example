# Canonical site URL — drives canonical tags, OG URLs, sitemap and JSON-LD.
# Set this to the real production domain before launch, or every SEO signal
# will point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://asynccreation.in

# Team portal login
TEAM_PASSCODE=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# Contact form email (via Web3Forms - free, sends to asynccreations@gmail.com)
WEB3FORMS_ACCESS_KEY=

# Vercel Postgres — stores gallery item metadata (category, title, size, image URL).
# Auto-populated if you link a Vercel Postgres/Neon store to this project;
# set manually if using a standalone Postgres instance.
POSTGRES_URL=

# Cloudflare R2 — stores the actual uploaded photos.
# R2_ACCOUNT_ID: your Cloudflare account ID (dashboard URL after login).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from an R2 API token (R2 > Manage API Tokens).
# R2_BUCKET_NAME: the bucket you created for gallery photos.
# R2_PUBLIC_URL: the bucket's public base URL (custom domain, or the r2.dev
#   URL with public access enabled) — no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
